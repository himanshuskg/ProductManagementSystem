@using ProductManagementSystem.BAL.DTOs.Common
@using ProductManagementSystem.BAL.DTOs.Products
@model PagedResultDto<ProductListDto>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid px-4 py-4">
   

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Product Management</h2>
            <p class="text-muted small m-0">View and manage your products</p>
        </div>
        <a href="/products/create" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary shadow-sm">
            Add New Product
        </a>
    </div>

    <div class="custom-card p-4">
        <form method="get" id="productFilterForm">
            <div class="row g-3 search-form-row">
                <div class="col-md-3">
                    <label class="search-label">Search</label>
                    <input id="searchText" name="SearchText"
                           value="@Context.Request.Query["SearchText"]"
                           class="k-textbox w-100" placeholder="Search by name..." />
                </div>

                <div class="col-md-2">
                    <label class="search-label">Min Qty</label>
                    <input id="minQty" name="MinQuantity" value="@Context.Request.Query["MinQuantity"]" class="w-100" />
                </div>

                <div class="col-md-2">
                    <label class="search-label">Min Price</label>
                    <input id="minPrice" name="MinPrice" value="@Context.Request.Query["MinPrice"]" class="w-100" />
                </div>

                <div class="col-md-2">
                    <label class="search-label">Max Price</label>
                    <input id="maxPrice" name="MaxPrice" value="@Context.Request.Query["MaxPrice"]" class="w-100" />
                </div>

                <div class="col-md-3">
                    <div class="d-flex gap-2 h-100 align-items-end">
                        <button type="submit" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-info flex-grow-1" style="height: 38px;">
                            Search
                        </button>
                        <a href="/products" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base" style="height: 38px;">
                            Clear
                        </a>
                    </div>
                </div>
            </div>
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
        </form>
    </div>

    <div class="custom-card overflow-hidden mt-4">
        <table class="table custom-table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Product Name</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var p in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@p.ProductName</td>
                            <td>
                                <span class="badge status-badge bg-light text-dark border">
                                    @p.Quantity
                                </span>
                            </td>
                            <td class="fw-bold text-primary">@p.Price.ToString("F2")</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/products/edit/@p.ProductId" class="k-button k-button-sm k-rounded-md k-button-solid k-button-solid-warning">
                                        <span class="k-button-text">Edit</span>
                                    </a>
                                    <a href="/products/details/@p.ProductId" class="k-button k-button-sm k-rounded-md k-button-solid k-button-solid-info">
                                        <span class="k-button-text">Details</span>
                                    </a>
                                    <a href="javascript:void(0)" class="k-button k-button-sm k-rounded-md k-button-solid k-button-solid-error"
                                       onclick="openDeleteModal('@p.ProductId', '@p.ProductName', '/products/delete')">
                                        <span class="k-button-text">Delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="bg-white py-3 px-4 border-top">
            <div class="row align-items-center">

                <div class="col-md-4 d-flex align-items-center gap-2">
                    <span class="text-muted small">Show</span>
                    <select class="form-select form-select-sm shadow-none border-2"
                            style="width: 80px; border-color: #f1f5f9;"
                            onchange="updateProductPageSize(this.value)">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="20" selected="@(Model.PageSize == 20)">20</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                    <span class="text-muted small">entries</span>
                </div>

                <div class="col-md-4">
                    @{
                        int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
                        if (totalPages < 1) totalPages = 1;
                    }
                    <nav>
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                                <a class="page-link shadow-none" href="?Page=@(Model.Page - 1)&SearchText=@Context.Request.Query["SearchText"]&MinQuantity=@Context.Request.Query["MinQuantity"]&MinPrice=@Context.Request.Query["MinPrice"]&MaxPrice=@Context.Request.Query["MaxPrice"]&PageSize=@Model.PageSize">Previous</a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link shadow-none" href="?Page=@i&SearchText=@Context.Request.Query["SearchText"]&MinQuantity=@Context.Request.Query["MinQuantity"]&MinPrice=@Context.Request.Query["MinPrice"]&MaxPrice=@Context.Request.Query["MaxPrice"]&PageSize=@Model.PageSize">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                                <a class="page-link shadow-none" href="?Page=@(Model.Page + 1)&SearchText=@Context.Request.Query["SearchText"]&MinQuantity=@Context.Request.Query["MinQuantity"]&MinPrice=@Context.Request.Query["MinPrice"]&MaxPrice=@Context.Request.Query["MaxPrice"]&PageSize=@Model.PageSize">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>

                <div class="col-md-4 text-end">
                    <p class="text-muted small mb-0">Showing @Model.Items.Count of @Model.TotalCount entries</p>
                </div>

            </div>
        </div>
    </div>
</div>

<partial name="_DeleteConfirmation" />

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#minQty").kendoNumericTextBox({ min: 0, format: "n0" });
            $("#minPrice").kendoNumericTextBox({ min: 0, format: "n2" });
            $("#maxPrice").kendoNumericTextBox({ min: 0, format: "n2" });
            $("#searchText").addClass("k-input-inner");
        });

        function updateProductPageSize(size) {
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('Page', '1');
            urlParams.set('PageSize', size);
            window.location.search = urlParams.toString();
        }
    </script>
}