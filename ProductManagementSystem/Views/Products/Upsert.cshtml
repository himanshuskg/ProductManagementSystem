@using ProductManagementSystem.BAL.DTOs.Products
@model ProductUpsertDto

<h2>@(Model.ProductId == null ? "Create Product" : "Edit Product")</h2>

<form asp-action="Save" method="post">
    <input type="hidden" asp-for="ProductId" />

    <div class="mb-2">
        <label>Product Name</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-2">
        <label>Quantity</label>
        <input asp-for="Quantity" type="number" min="0" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Price</label>
        <input asp-for="Price" type="number" min="0" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Categories</label>
        <select asp-for="SelectedCategoryIds"
                asp-items="@(new MultiSelectList(Model.Categories, "CategoryId", "CategoryName"))"
                multiple
                class="form-control">
        </select>
    </div>

    <button class="btn btn-primary">Save</button>
    <a href="/products" class="btn btn-secondary">Cancel</a>
</form>
