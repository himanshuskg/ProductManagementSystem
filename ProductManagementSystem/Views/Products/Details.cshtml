@using ProductManagementSystem.BAL.DTOs.Products
@model ProductDetailDto

@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Product Details</h2>
            <p class="text-muted mb-0 small">Full specifications for <strong>@Model.ProductName</strong></p>
        </div>
        <a href="/products" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="custom-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="p-3 rounded-3 me-3" style="background-color: #f8fafc; border: 1px solid #f1f5f9;">
                            <i class="bi bi-box-seam text-secondary fs-3"></i>
                        </div>
                        <div>
                            <span class="search-label d-block mb-0" style="font-size: 0.7rem; text-transform: uppercase;">Product Name</span>
                            <h3 class="fw-bold text-dark m-0">@Model.ProductName</h3>
                        </div>
                    </div>

                    <div class="row g-4 mt-2">
                        <div class="col-md-6">
                            <label class="search-label d-block text-uppercase">Current Price</label>
                            <div class="fs-2 fw-bold" style="color: #ff6358;">@Model.Price.ToString("F2")</div>
                        </div>

                        <div class="col-md-6">
                            <label class="search-label d-block text-uppercase">Stock Level</label>
                            <div class="fs-2 fw-bold text-dark">
                                @Model.Quantity
                                <span class="fs-6 fw-normal text-muted">Items</span>
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <label class="search-label d-block text-uppercase">Description</label>
                            <div class="p-3 rounded-3 border" style="background-color: #f8fafc; border-color: #f1f5f9 !important; line-height: 1.6;">
                                @(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top-0 p-4 pt-0">
                    <a href="/products/edit/@Context.Request.RouteValues["id"]" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary px-4 py-2">
                        <span class="k-button-text">Edit This Product</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="custom-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-tags-fill me-2 text-secondary"></i>
                        <h5 class="fw-bold m-0" style="color: #475569;">Categories</h5>
                    </div>

                    @if (Model.Categories != null && Model.Categories.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var c in Model.Categories)
                            {
                                <span class="status-badge border" style="background-color: #f8fafc; color: #64748b; font-size: 0.85rem;">
                                    @c
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 border rounded-3 border-dashed" style="border-style: dashed !important;">
                            <p class="text-muted small m-0">No categories assigned</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>