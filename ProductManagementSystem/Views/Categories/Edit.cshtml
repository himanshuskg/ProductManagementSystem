@using ProductManagementSystem.BAL.DTOs.Category
@model CategoryDto

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Edit Category</h2>
            <p class="text-muted mb-0 small">Update details for <strong>@Model.CategoryName</strong></p>
        </div>
        <a href="/categories" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base shadow-sm">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <form method="post">
        <input type="hidden" asp-for="CategoryId" />

        <div class="custom-card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <div class="row g-4">

                    <div class="col-md-12">
                        <label asp-for="CategoryName" class="search-label d-block text-uppercase">
                            Category Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CategoryName" class="form-control border-2 shadow-none"
                               placeholder="Enter category name..."
                               style="border-color: #f1f5f9;" />
                        <span asp-validation-for="CategoryName" class="text-danger small fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="search-label d-block text-uppercase">
                            Description <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Description" rows="5" class="form-control border-2 shadow-none"
                                  placeholder="Provide a detailed description..."
                                  style="border-color: #f1f5f9;"></textarea>
                        <span asp-validation-for="Description" class="text-danger small fw-bold mt-1 d-block"></span>
                    </div>

                </div>
            </div>

            <div class="card-footer bg-white p-4 d-flex justify-content-end gap-2 border-0">
                <a href="/categories" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base px-4">
                    Cancel
                </a>
                <button type="submit" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary px-5 shadow-sm">
                    <span class="k-button-text">Update Category</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        /* Maintain focus consistency with your site-custom.css primary color */
        .form-control:focus {
            border-color: #ff6358 !important;
            box-shadow: 0 0 0 0.25rem rgba(255, 99, 88, 0.1) !important;
        }
    </style>
}