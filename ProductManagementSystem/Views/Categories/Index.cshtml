@using ProductManagementSystem.BAL.DTOs.Category
@using ProductManagementSystem.BAL.DTOs.Common
@model PagedResultDto<CategoryListDto>

<h2>Categories</h2>
<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-4">
            <input name="SearchText"
                   value="@Context.Request.Query["SearchText"]"
                   class="form-control"
                   placeholder="Search category" />
        </div>

        <div class="col-md-3">
            <button class="btn btn-primary">Search</button>
            <a href="/categories" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

<a href="/categories/create" class="btn btn-success mb-2">Add Category</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Items)
        {
            <tr>
                <td>@c.CategoryName</td>
                <td>@c.Description</td>
                <td>
                    <a href="/categories/edit/@c.CategoryId" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/categories/delete/@c.CategoryId"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete category?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>
@{
    int totalPages = (int)Math.Ceiling(
        (double)Model.TotalCount / Model.PageSize
    );
}

